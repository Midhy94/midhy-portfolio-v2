# ==============================================================================
# Environment Configuration Template — Safe Placeholders Only
# NEVER commit real API keys, secrets, or credentials to source control.
# Real production secrets must be managed via hosting provider environment settings.
# All VITE_* variables are bundled into client-side code and exposed to browsers.
# ==============================================================================

# Application URL & Canonical Domain
VITE_SITE_URL=https://your-domain.com

# Future Supabase Integration (Frontend Public Anonymous Access Only)
# DO NOT place service_role or secret keys in any VITE_* variable.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-placeholder
